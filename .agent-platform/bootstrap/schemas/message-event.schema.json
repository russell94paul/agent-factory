{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentInteractionEvent",
  "type": "object",
  "required": [
    "message_id",
    "mission_id",
    "sender",
    "type",
    "created_at"
  ],
  "properties": {
    "message_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sender": {
      "type": "string"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "directive",
        "question",
        "observation",
        "evidence",
        "claim",
        "warning",
        "proposal",
        "decision",
        "handoff",
        "state_update",
        "learning"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object"
    }
  }
}